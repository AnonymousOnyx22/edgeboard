# Secrets - never commit
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local database
data/db.sqlite*

# Cached API responses. These are rebuilt on demand and would otherwise put
# hundreds of throwaway JSON files in the repo.
data/espn_cache/
data/player_cache/
data/props_cache/
data/schedule_cache/
data/odds_cache/
data/credits.json

# Runtime state written by the app
data/automation_status.json
data/result_check_status.json
data/.edgeboard-session-secret
data/*.lock

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
