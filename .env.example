# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# The Odds API - https://the-odds-api.com
# Free tier is 500 credits/month. Optional: without it the tool falls back to
# ESPN's embedded game lines, and player props become a model-only watchlist.
ODDS_API_KEY=

# Optional fixed Flask session secret. If blank, a fresh secure local secret is
# generated each time the dashboard starts.
EDGEBOARD_SECRET=

# ---------------------------------------------------------------- hosting
# A hosted copy MUST set EDGEBOARD_SECRET, or every restart logs everyone out.
# Where the database lives (point it at a persistent disk).
EDGEBOARD_DB=
# 1 = public service: accounts, plans and the 19+ age gate switch on.
EDGEBOARD_SERVICE=0
# 0 on extra web processes so only one runs the hourly sync worker.
EDGEBOARD_SCHEDULER=1

# ---------------------------------------------------------------- Stripe
# Payments stay off until these are set. Prices are Stripe Price IDs (price_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_SHARP_MONTHLY=
STRIPE_PRICE_SHARP_YEARLY=

# Only used by the archived Instagram content generator in archive/.
# Leave blank unless you restore it.
IG_LONG_TOKEN=
