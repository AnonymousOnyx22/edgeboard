# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# The Odds API - https://the-odds-api.com
# Free tier is 500 credits/month. Optional: without it the tool falls back to
# ESPN's embedded game lines, and player props become a model-only watchlist.
ODDS_API_KEY=

# Only used by the archived Instagram content generator in archive/.
# Leave blank unless you restore it.
IG_LONG_TOKEN=
